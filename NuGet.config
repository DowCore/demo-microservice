<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!--
    中央包管理（Directory.Packages.props）下，NuGet 要求单一包源或显式包源映射，
    否则报 NU1507。这里把所有包固定到 nuget.org，同时防止依赖混淆（dependency confusion）。
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
