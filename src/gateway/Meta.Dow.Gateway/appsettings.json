{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "administration": {
                "ClusterId": "administration",
                "Match": {
                    "Path": "/api/administration/{*any}"
                }
            },
            "identity": {
                "ClusterId": "identity",
                "Match": {
                    "Path": "/api/identity/{*any}"
                }
            },
            "account": {
                "ClusterId": "account",
                "Match": {
                    "Path": "/api/account/{*any}"
                }
            },
            "saas": {
                "ClusterId": "saas",
                "Match": {
                    "Path": "/api/multi-tenancy/{*any}"
                }
            },
            "saas-orchestration": {
                "ClusterId": "saas",
                "Match": {
                    "Path": "/api/orchestration/{*any}"
                }
            },
            "saas-logic": {
                "ClusterId": "saas",
                "Match": {
                    "Path": "/api/logic/{*any}"
                }
            },
            "saas-feature-management": {
                "ClusterId": "saas",
                "Match": {
                    "Path": "/api/feature-management/{*any}"
                }
            },
            "setting-management": {
                "ClusterId": "administration",
                "Match": {
                    "Path": "/api/setting-management/{*any}"
                }
            },
            "projects": {
                "ClusterId": "projects",
                "Match": {
                    "Path": "/api/projects/{*any}"
                }
            },
            "abp": {
                "ClusterId": "administration",
                "Match": {
                    "Path": "/api/abp/{*any}"
                }
            },
            "menu": {
                "ClusterId": "administration",
                "Match": {
                    "Path": "/api/menu/{*any}"
                }
            },
            "permission-management": {
                "ClusterId": "administration",
                "Match": {
                    "Path": "/api/permission-management/{*any}"
                }
            },
            "administration-fallback": {
                "ClusterId": "administration",
                "AuthorizationPolicy": "Default",
                "Match": {
                    "Path": "{**catch-all}"
                }
            }
        },
        "Clusters": {
            "administration": {
                "Destinations": {
                    "administration": {
                        "Address": "https://localhost:7001"
                    }
                },
                "HttpRequest": {
                    "ActivityTimeout": "00:00:30"
                }
            },
            "identity": {
                "Destinations": {
                    "identity": {
                        "Address": "https://localhost:7002"
                    }
                },
                "HttpRequest": {
                    "ActivityTimeout": "00:00:30"
                }
            },
            "account": {
                "Destinations": {
                    "account": {
                        "Address": "https://localhost:7002"
                    }
                },
                "HttpRequest": {
                    "ActivityTimeout": "00:00:30"
                }
            },
            "saas": {
                "Destinations": {
                    "saas": {
                        "Address": "https://localhost:7003"
                    }
                },
                "HttpRequest": {
                    "ActivityTimeout": "00:00:30"
                }
            },
            "projects": {
                "Destinations": {
                    "projects": {
                        "Address": "https://localhost:7004"
                    }
                },
                "HttpRequest": {
                    "ActivityTimeout": "00:00:30"
                }
            }
        }
    },
    "AuthServer": {
        "Authority": "https://localhost:7600/",
        "ValidAudiences": [],
        "RequireHttpsMetadata": "false"
    }
}
