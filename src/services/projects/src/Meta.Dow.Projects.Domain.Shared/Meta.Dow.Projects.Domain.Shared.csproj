    <RootNamespace>Meta.Dow.Projects</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Volo.Abp.Validation" Version="10.6.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\Projects\*.json" />
    <Content Remove="Localization\Projects\*.json" />
  </ItemGroup>
</Project>
